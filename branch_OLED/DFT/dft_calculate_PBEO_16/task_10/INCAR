SYSTEM = Step2_PBE0_Final_Calc

! --- 1. 读取第一步的波函数 (核心) ---
ISTART = 1           ! 读取当前目录下的 WAVECAR
ICHARG = 0           ! 从波函数构建初始电荷

! --- 2. 杂化泛函 PBE0 设置 (复刻 OE62) ---
LHFCALC  = .TRUE.    ! 开启杂化泛函
GGA      = PE        ! 指定 PBE
AEXX     = 0.25      ! 25% HF 交换项 (标准 PBE0)

! --- 3. 内存拯救参数 (生死攸关) ---
PRECFOCK = Fast      ! 【必须有】降低 Fock 矩阵的 FFT 网格精度 (省内存神器)
KPAR     = 1         ! 【必须是1】严禁 K 点并行，否则内存翻倍
NCORE    = 1         ! 【必须是1】单核独享内存，最慢但最稳
! NKRED  = 2         ! 【千万别加】之前报错就是因为它，已删除！

! --- 4. 算法与收敛 ---
ALGO     = All       ! 杂化泛函推荐算法 (共轭梯度)
TIME     = 0.4       ! 配合 ALGO=All 使用
EDIFF    = 1E-6      ! 收敛精度
NELM     = 100       ! 最大电子步数

! --- 5. 精度与物理参数 ---
PREC     = Normal    ! 用 Normal 省内存 (对 Gap 影响很小)
ENCUT    = 500       ! 保持 500 eV
ISMEAR   = 0         ! 高斯展宽
SIGMA    = 0.05      ! 展宽宽度
IVDW     = 2         ! TS 范德华修正 (OE62 标准)
LASPH    = .TRUE.    ! 提高精度 (考虑非球形贡献)

! --- 6. 离子步与输出 ---
IBRION   = -1        ! 离子不动 (单点能)
NSW      = 0         
LWAVE    = .FALSE.   ! 算完不用写盘了，省空间
LCHARG   = .FALSE.   ! 不写电荷